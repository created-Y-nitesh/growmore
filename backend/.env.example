# ============================================================================
# GrowMore Production Environment Template (.env.example)
# IMPORTANT: Keep real secrets server-side. Never commit populated .env files.
# ============================================================================

# 1. Server Configuration
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://app.growmore.com

# 2. Database Configuration (Managed PostgreSQL: RDS / Supabase / Neon / Render)
# Use either discrete parameters or a complete connection string:
DB_HOST=your_managed_postgres_host.internal
DB_PORT=5432
DB_NAME=growmore_db
DB_USER=growmore_app_user
DB_PASSWORD=your_secure_db_password
DATABASE_URL=postgresql://growmore_app_user:your_secure_db_password@your_managed_postgres_host.internal:5432/growmore_db?sslmode=require

# 3. Security & Authentication
JWT_SECRET=generate_a_cryptographically_random_64_char_secret_key
JWT_EXPIRES_IN=7d

# 4. Supabase Administrative Integration (Server-Side Only)
# CRITICAL: SUPABASE_SERVICE_ROLE_KEY must NEVER be committed or shared with frontend clients.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_privileged_service_role_secret_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# 4. Real SMS OTP Provider Configuration (Twilio / MSG91 / Fast2SMS)
# To enable real SMS delivery to user mobile numbers, configure one of the providers below:
# Option A: Twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Option B: MSG91
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_dlt_approved_template_id
MSG91_SENDER_ID=GRWMOR

# Option C: Fast2SMS
FAST2SMS_API_KEY=your_fast2sms_api_key

# 5. Payment Provider Configuration (UroPay UPI Gateway)
PAYMENT_PROVIDER=uropay
UROPAY_API_KEY=your_uropay_api_key_here
UROPAY_API_SECRET=your_uropay_api_secret_here
UROPAY_WEBHOOK_SECRET=your_uropay_webhook_secret_here
UROPAY_BASE_URL=https://api.uropai.in

# 5. Banking Payout Provider Configuration (e.g., RazorpayX / Cashfree Payouts)
# Keep disabled until banking accounts & corporate verification are validated
PAYOUT_PROVIDER=disabled
PAYOUT_KEY_ID=your_payout_key_id
PAYOUT_KEY_SECRET=your_payout_key_secret
PAYOUT_ACCOUNT_NUMBER=your_commercial_escrow_account_number

# 6. Financial Safety Controls & Return Engine
# CRITICAL: Keep FALSE until financial model, legal authorization, and compliance are verified
ENABLE_LIVE_RETURN_CREDITING=false
ENABLE_LIVE_PAYMENT_SETTLEMENT=false

# 7. Initial Admin Provisioning (Optional / CLI use)
# ADMIN_EMAIL=admin@growmore.com
# ADMIN_PASSWORD=your_initial_admin_password
