# ==============================================================================
# GrowMore Frontend Environment Variables (.env)
# ==============================================================================

# Backend API Endpoint
# In production: point to your deployed backend (e.g., https://api.growmore.app/api)
VITE_API_BASE_URL=http://localhost:5000/api

# Supabase Auth & Client Public Configuration
# Retrieve these from your Supabase Project Settings -> API
# IMPORTANT: ONLY configure your Project URL and public anon key here.
# NEVER expose your privileged SUPABASE_SERVICE_ROLE_KEY to the browser.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
